---
---

<header class="fixed top-5 sm:top-8 z-50 w-full px-4 flex justify-center pointer-events-none">
	<div 
		id="expandable-menu"
		class="pointer-events-auto group relative w-full max-w-[340px] sm:max-w-[355px] rounded-[1.6rem] bg-[var(--surface)]/95 border border-[var(--border)] backdrop-blur-md shadow-xl shadow-[var(--shadow-color)] transition-all duration-300 ease-out overflow-hidden"
	>
		<!-- Top Pill Header (Always Visible) -->
		<div id="menu-trigger" class="flex items-center justify-between p-1.5 cursor-pointer select-none">
			<!-- Avatar & Title -->
			<div class="flex items-center gap-2.5 pl-1 py-1">
				<!-- Interactive Avatar Trigger -->
				<button 
					type="button" 
					id="avatar-trigger" 
					class="relative size-9 sm:size-10 shrink-0 cursor-pointer rounded-full ring-1 ring-[var(--border)] hover:ring-2 hover:ring-[var(--accent)] hover:scale-105 active:scale-95 transition-all duration-300 group/avatar p-0 bg-transparent text-left focus:outline-none"
					title="Klik untuk memperbesar foto profil"
					aria-label="Perbesar foto profil"
				>
					<img 
						src="/profile.jpeg" 
						alt="Hoiril Mochtar" 
						class="size-full rounded-full object-cover object-top" 
						loading="eager"
					/>
					<span class="absolute bottom-0 right-0 size-2.5 bg-emerald-500 rounded-full ring-2 ring-[var(--surface)] pointer-events-none"></span>
				</button>
				
				<div class="flex flex-col text-left leading-tight overflow-hidden">
					<span class="font-semibold text-xs sm:text-sm text-[var(--fg)] tracking-tight">Hoiril Mochtar</span>
					
					<!-- Subtitle: Dynamic Status when collapsed / Location when expanded -->
					<div class="relative h-5 w-44 overflow-hidden text-xs">
						<!-- Location shown when expanded/hovered -->
						<div id="nav-location" class="absolute inset-0 flex items-center gap-1 text-[var(--muted)] font-medium leading-5 transition-all duration-300 transform translate-y-full opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-[.is-open]:translate-y-0 group-[.is-open]:opacity-100">
							<span>📍 Madura, Indonesia</span>
						</div>

						<!-- Cycling status shown when collapsed -->
						<div id="nav-cycling-status" class="absolute inset-0 h-full transition-all duration-300 transform translate-y-0 opacity-100 group-hover:-translate-y-full group-hover:opacity-0 group-[.is-open]:-translate-y-full group-[.is-open]:opacity-0">
							<span id="status-text-1" class="absolute inset-0 flex items-center text-[var(--muted)] leading-5 whitespace-nowrap transition-all duration-500 transform translate-y-0 opacity-100">
								Middleware Engineer
							</span>
							<span id="status-text-2" class="absolute inset-0 flex items-center text-emerald-600 dark:text-emerald-400 font-medium leading-5 whitespace-nowrap transition-all duration-500 transform translate-y-full opacity-0">
								Available for work
							</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Right Hint / Keyboard Shortcut -->
			<div class="pr-2 flex items-center gap-1.5 text-[var(--muted)]">
				<kbd class="hidden sm:inline-flex items-center gap-0.5 text-[11px] font-mono px-1.5 py-0.5 rounded-md bg-[var(--pill-bg)] border border-[var(--border)] text-[var(--muted)]">
					<span class="text-[9px]">⌘</span>K
				</kbd>
				<svg class="size-4 transition-transform duration-300 group-hover:rotate-180 group-[.is-open]:rotate-180 text-[var(--muted)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m6 9 6 6 6-6"/>
				</svg>
			</div>
		</div>

		<!-- Expandable Menu Body (Smooth Grid Transition) -->
		<div 
			id="menu-body"
			class="grid transition-[grid-template-rows,opacity] duration-300 ease-out grid-rows-[0fr] opacity-0 group-hover:grid-rows-[1fr] group-hover:opacity-100 group-[.is-open]:grid-rows-[1fr] group-[.is-open]:opacity-100"
		>
			<div class="overflow-hidden flex flex-col px-2 pb-2">
				<div class="h-px bg-[var(--border)] my-1.5 mx-1"></div>

				<!-- Section Links -->
				<div class="flex flex-col gap-0.5 py-1">
					<span class="text-[11px] font-semibold text-[var(--muted)] px-3 py-1 tracking-wider uppercase">
						Sections
					</span>

					<a href="#hero" class="menu-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs text-[var(--fg)] hover:bg-[var(--surface-hover)] transition-colors">
						<svg class="size-4 text-[var(--muted)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
						<span>Home</span>
					</a>

					<a href="#experience" class="menu-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs text-[var(--fg)] hover:bg-[var(--surface-hover)] transition-colors">
						<svg class="size-4 text-[var(--muted)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
						<span>Experience</span>
					</a>

					<a href="#integrations" class="menu-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs text-[var(--fg)] hover:bg-[var(--surface-hover)] transition-colors">
						<svg class="size-4 text-[var(--muted)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
						<span>Key Integrations</span>
					</a>

					<a href="#projects" class="menu-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs text-[var(--fg)] hover:bg-[var(--surface-hover)] transition-colors">
						<svg class="size-4 text-[var(--muted)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
						<span>Side Projects</span>
					</a>

					<a href="#stack" class="menu-link flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs text-[var(--fg)] hover:bg-[var(--surface-hover)] transition-colors">
						<svg class="size-4 text-[var(--muted)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
						<span>Tech Stack</span>
					</a>
				</div>

				<div class="h-px bg-[var(--border)] my-1.5 mx-1"></div>

				<!-- Theme Selector (Segmented Control) -->
				<div class="flex flex-col gap-1.5 py-1">
					<span class="text-[11px] font-semibold text-[var(--muted)] px-3 tracking-wider uppercase">
						Theme
					</span>

					<div class="grid grid-cols-3 gap-1 p-1 rounded-2xl bg-[var(--pill-bg)] border border-[var(--border)]">
						<button 
							type="button" 
							data-theme-val="light" 
							class="theme-btn flex items-center justify-center gap-1.5 py-1.5 rounded-xl text-xs font-medium text-[var(--muted)] hover:text-[var(--fg)] transition-all cursor-pointer"
						>
							<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="4"></circle>
								<path d="M12 2v2"></path>
								<path d="M12 20v2"></path>
								<path d="m4.93 4.93 1.41 1.41"></path>
								<path d="m17.66 17.66 1.41 1.41"></path>
								<path d="M2 12h2"></path>
								<path d="M20 12h2"></path>
								<path d="m6.34 17.66-1.41 1.41"></path>
								<path d="m19.07 4.93-1.41 1.41"></path>
							</svg>
							<span>Light</span>
						</button>

						<button 
							type="button" 
							data-theme-val="dark" 
							class="theme-btn flex items-center justify-center gap-1.5 py-1.5 rounded-xl text-xs font-medium text-[var(--muted)] hover:text-[var(--fg)] transition-all cursor-pointer"
						>
							<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
							</svg>
							<span>Dark</span>
						</button>

						<button 
							type="button" 
							data-theme-val="system" 
							class="theme-btn flex items-center justify-center gap-1.5 py-1.5 rounded-xl text-xs font-medium text-[var(--muted)] hover:text-[var(--fg)] transition-all cursor-pointer"
						>
							<svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>
							</svg>
							<span>System</span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Full-Cover Avatar Photo Overlay (Completely covers entire menu view) -->
		<div 
			id="avatar-fullcover-overlay"
			class="absolute inset-0 z-30 w-full h-full rounded-[1.6rem] overflow-hidden bg-[var(--surface)] transition-all duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-0 scale-95 pointer-events-none select-none cursor-pointer flex flex-col justify-between"
			title="Klik di mana saja untuk kembali ke menu"
		>
			<!-- High-Resolution Full Portrait Image -->
			<img 
				src="/profile.jpeg" 
				alt="Hoiril Mochtar Portrait" 
				class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 hover:scale-105"
			/>

			<!-- Top Action Bar (Close Button) -->
			<div class="relative z-10 w-full flex justify-end p-3">
				<button 
					type="button" 
					id="avatar-cover-close-btn"
					class="p-2 rounded-full bg-black/60 hover:bg-black/85 text-white backdrop-blur-md transition-all hover:scale-110 active:scale-95 cursor-pointer shadow-lg border border-white/15"
					aria-label="Tutup foto profil"
					title="Tutup foto profil (ESC)"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
			</div>

			<!-- Bottom Profile Details Overlay -->
			<div class="relative z-10 p-4 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex flex-col gap-1 text-white">
				<div class="flex items-center gap-2">
					<span class="font-bold text-base text-white">Hoiril Mochtar</span>
					<span class="size-2 bg-emerald-400 rounded-full animate-pulse"></span>
				</div>
				<p class="text-xs text-white/90 font-medium">Senior Middleware Engineer</p>
				<div class="flex items-center justify-between pt-1.5 border-t border-white/15 text-[11px] text-white/70">
					<span>📍 Madura, Indonesia</span>
					<span class="text-white/60">Klik untuk kembali</span>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	function setupNavbar() {
		// Cycling Status
		const status1 = document.getElementById('status-text-1');
		const status2 = document.getElementById('status-text-2');
		let currentStatus = 1;

		if (status1 && status2) {
			setInterval(() => {
				if (currentStatus === 1) {
					status1.classList.replace('translate-y-0', '-translate-y-full');
					status1.classList.replace('opacity-100', 'opacity-0');
					
					status2.classList.replace('translate-y-full', 'translate-y-0');
					status2.classList.replace('opacity-0', 'opacity-100');
					currentStatus = 2;
				} else {
					status2.classList.replace('translate-y-0', 'translate-y-full');
					status2.classList.replace('opacity-100', 'opacity-0');
					
					status1.classList.replace('-translate-y-full', 'translate-y-0');
					status1.classList.replace('opacity-0', 'opacity-100');
					currentStatus = 1;
				}
			}, 3500);
		}

		// Menu & Full-Cover Avatar Expand Logic
		const menuCard = document.getElementById('expandable-menu');
		const menuTrigger = document.getElementById('menu-trigger');
		const avatarTrigger = document.getElementById('avatar-trigger');
		const avatarFullcoverOverlay = document.getElementById('avatar-fullcover-overlay');
		const avatarCoverCloseBtn = document.getElementById('avatar-cover-close-btn');

		let isAvatarFullcover = false;

		const showFullcoverAvatar = () => {
			if (!avatarFullcoverOverlay || !menuCard) return;
			isAvatarFullcover = true;
			menuCard.classList.add('is-open');

			avatarFullcoverOverlay.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
			avatarFullcoverOverlay.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
		};

		const hideFullcoverAvatar = () => {
			if (!avatarFullcoverOverlay) return;
			isAvatarFullcover = false;

			avatarFullcoverOverlay.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
			avatarFullcoverOverlay.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
		};

		if (avatarTrigger) {
			avatarTrigger.addEventListener('click', (e) => {
				e.stopPropagation();
				if (isAvatarFullcover) {
					hideFullcoverAvatar();
				} else {
					showFullcoverAvatar();
				}
			});
		}

		if (avatarFullcoverOverlay) {
			avatarFullcoverOverlay.addEventListener('click', (e) => {
				e.stopPropagation();
				hideFullcoverAvatar();
			});
		}

		if (avatarCoverCloseBtn) {
			avatarCoverCloseBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				hideFullcoverAvatar();
			});
		}

		if (menuCard && menuTrigger) {
			let leaveTimeout: number | undefined;

			menuCard.addEventListener('mouseenter', () => {
				window.clearTimeout(leaveTimeout);
				menuCard.classList.add('is-open');
			});

			menuCard.addEventListener('mouseleave', () => {
				leaveTimeout = window.setTimeout(() => {
					menuCard.classList.remove('is-open');
					hideFullcoverAvatar();
				}, 200);
			});

			// Toggle with Click on trigger (ignoring if avatar clicked)
			menuTrigger.addEventListener('click', (e) => {
				if (avatarTrigger && avatarTrigger.contains(e.target as Node)) return;
				e.stopPropagation();
				const willOpen = !menuCard.classList.contains('is-open');
				menuCard.classList.toggle('is-open');
				if (!willOpen) {
					hideFullcoverAvatar();
				}
			});

			// Close when clicking outside
			document.addEventListener('click', (e) => {
				if (!menuCard.contains(e.target as Node)) {
					menuCard.classList.remove('is-open');
					hideFullcoverAvatar();
				}
			});

			// Close when clicking any menu link
			document.querySelectorAll('.menu-link').forEach(link => {
				link.addEventListener('click', () => {
					menuCard.classList.remove('is-open');
					hideFullcoverAvatar();
				});
			});

			// Keyboard shortcut (⌘K or Ctrl+K / Escape)
			document.addEventListener('keydown', (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
					e.preventDefault();
					const willOpen = !menuCard.classList.contains('is-open');
					menuCard.classList.toggle('is-open');
					if (!willOpen) hideFullcoverAvatar();
				} else if (e.key === 'Escape') {
					if (isAvatarFullcover) {
						hideFullcoverAvatar();
					} else {
						menuCard.classList.remove('is-open');
					}
				}
			});
		}

		// Theme Segmented Control Logic
		const themeBtns = document.querySelectorAll('.theme-btn');
		
		function applyTheme(themeValue: string) {
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			
			if (themeValue === 'dark') {
				document.documentElement.classList.add('dark');
				localStorage.setItem('theme', 'dark');
			} else if (themeValue === 'light') {
				document.documentElement.classList.remove('dark');
				localStorage.setItem('theme', 'light');
			} else { // System
				localStorage.removeItem('theme');
				if (prefersDark) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			}

			// Update button active state
			themeBtns.forEach(btn => {
				const val = btn.getAttribute('data-theme-val');
				if (val === themeValue) {
					btn.classList.add('bg-[var(--surface)]', 'text-[var(--fg)]', 'shadow-xs');
					btn.classList.remove('text-[var(--muted)]');
				} else {
					btn.classList.remove('bg-[var(--surface)]', 'text-[var(--fg)]', 'shadow-xs');
					btn.classList.add('text-[var(--muted)]');
				}
			});
		}

		const savedTheme = localStorage.getItem('theme') || 'system';
		applyTheme(savedTheme);

		themeBtns.forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const val = btn.getAttribute('data-theme-val');
				if (val) {
					applyTheme(val);
				}
			});
		});
	}

	setupNavbar();
	document.addEventListener('astro:page-load', setupNavbar);
</script>
