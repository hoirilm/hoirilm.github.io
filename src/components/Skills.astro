---
---

<section id="skills" class="py-24">
	<div class="reveal mb-12 flex items-center gap-4">
		<h2 class="text-2xl md:text-3xl font-bold text-white">
			<span class="text-emerald-400 font-mono text-xl mr-2"
				>03.</span
			> Technical Arsenal
		</h2>
		<div class="h-px bg-zinc-800 flex-grow max-w-xs"></div>
	</div>

	<div
		class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 reveal"
	>
		<!-- Skill Category 1 -->
		<div
			class="glass-card p-6 rounded-xl group transition-all duration-300"
		>
			<h3 class="text-emerald-400 font-mono text-sm mb-4">
				Core Languages
			</h3>
			<div
				class="flex flex-wrap gap-2 text-sm text-zinc-300 font-medium"
			>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Golang</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Java</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>SQL</span
				>
			</div>
		</div>

		<!-- Skill Category 2 -->
		<div
			class="glass-card p-6 rounded-xl group transition-all duration-300"
		>
			<h3 class="text-emerald-400 font-mono text-sm mb-4">
				Architecture & Protocols
			</h3>
			<div
				class="flex flex-wrap gap-2 text-sm text-zinc-300 font-medium"
			>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Microservices</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>ISO 8583</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>REST / SOAP</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>gRPC</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>JSON/XML</span
				>
			</div>
		</div>

		<!-- Skill Category 3 -->
		<div
			class="glass-card p-6 rounded-xl group transition-all duration-300"
		>
			<h3 class="text-emerald-400 font-mono text-sm mb-4">
				Infra & Messaging
			</h3>
			<div
				class="flex flex-wrap gap-2 text-sm text-zinc-300 font-medium"
			>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Kubernetes</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Docker</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>NATS</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Fiorano</span
				>
			</div>
		</div>

		<!-- Skill Category 4 -->
		<div
			class="glass-card p-6 rounded-xl group transition-all duration-300"
		>
			<h3 class="text-emerald-400 font-mono text-sm mb-4">
				Data & Analytics
			</h3>
			<div
				class="flex flex-wrap gap-2 text-sm text-zinc-300 font-medium"
			>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>PostgreSQL</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Redis</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Elasticsearch</span
				>
				<span
					class="px-2 py-1 bg-zinc-900 rounded border border-zinc-800"
					>Kibana</span
				>
			</div>
		</div>
	</div>
</section>
