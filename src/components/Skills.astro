---

<section id="stack" class="w-full flex flex-col gap-6 scroll-mt-24">
	<!-- Section Header -->
	<div class="flex items-center gap-2 text-[var(--fg)]">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--accent)]">
			<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
		</svg>
		<h2 class="text-xl sm:text-2xl font-bold tracking-tight">Tech Stack &amp; Tools</h2>
	</div>

	<!-- Stack Grid -->
	<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
		{techStack.map((tech) => (
			<div class="squircle border border-[var(--border)] bg-[var(--surface)] p-3.5 flex flex-col items-center justify-center gap-2 text-center hover:border-[var(--accent)]/50 hover:bg-[var(--surface-hover)] transition-all duration-200 group cursor-default">
				<div class="text-[var(--muted)] group-hover:text-[var(--accent)] group-hover:scale-110 transition-all duration-200" set:html={tech.svg} />
				<span class="text-xs font-semibold text-[var(--fg)] tracking-tight">
					{tech.name}
				</span>
				<span class="text-[10px] text-[var(--muted)] font-mono leading-none">
					{tech.category}
				</span>
			</div>
		))}
	</div>
</section>
