<script>
	// --- Carousel Logic (Drag & Buttons) ---
	const container = document.getElementById("projectContainer");
	const prevBtn = document.getElementById("prevBtn");
	const nextBtn = document.getElementById("nextBtn");

	if (container && prevBtn && nextBtn) {
		let isDown = false;
		let startX;
		let scrollLeft;

		// Button Scroll
		prevBtn.addEventListener("click", () => {
			container.scrollBy({ left: -400, behavior: "smooth" });
		});
		nextBtn.addEventListener("click", () => {
			container.scrollBy({ left: 400, behavior: "smooth" });
		});

		// Drag to Scroll
		container.addEventListener("mousedown", (e) => {
			isDown = true;
			container.classList.add("active:cursor-grabbing");
			container.classList.remove("snap-mandatory"); // Disable snapping while dragging
			startX = e.pageX - container.offsetLeft;
			scrollLeft = container.scrollLeft;
		});

		container.addEventListener("mouseleave", () => {
			isDown = false;
			container.classList.remove("active:cursor-grabbing");
			container.classList.add("snap-mandatory");
		});

		container.addEventListener("mouseup", () => {
			isDown = false;
			container.classList.remove("active:cursor-grabbing");
			container.classList.add("snap-mandatory");
		});

		container.addEventListener("mousemove", (e) => {
			if (!isDown) return;
			e.preventDefault();
			const x = e.pageX - container.offsetLeft;
			const walk = (x - startX) * 2; // Scroll-fast multiplier
			container.scrollLeft = scrollLeft - walk;
		});
	}
</script>
