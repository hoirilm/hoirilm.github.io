</section>

<script>
	// --- Multi-sentence Typewriter Effect for Hero Section ---
	const phrases = [
		"I architect enterprise middleware.",
		"I integrate banking ecosystems.",
		"I explore AI-driven solutions.",
		"I build high-availability systems.",
	];

	const typeContainer = document.getElementById("typewriter-text");

	let phraseIndex = 0;
	let charIndex = 0;
	let isDeleting = false;
	let typingDelay = 100;
	let erasingDelay = 50;
	let newPhraseDelay = 2000; // Time to wait before deleting

	function typeLoop() {
		if (!typeContainer) return;

		const currentPhrase = phrases[phraseIndex];
		let delay = isDeleting ? erasingDelay : typingDelay;

		if (isDeleting) {
			// Erasing
			typeContainer.textContent = currentPhrase.substring(0, charIndex - 1);
			charIndex--;
		} else {
			// Typing
			typeContainer.textContent = currentPhrase.substring(0, charIndex + 1);
			charIndex++;
		}

		// Logic to switch modes
		if (!isDeleting && charIndex === currentPhrase.length) {
			// End of typing, wait then start deleting
			isDeleting = true;
			delay = newPhraseDelay;
		} else if (isDeleting && charIndex === 0) {
			// End of deleting, move to next phrase
			isDeleting = false;
			phraseIndex = (phraseIndex + 1) % phrases.length;
			delay = typingDelay; // Optional: wait a bit before typing next phrase, but typingDelay is fine
		}
		
		setTimeout(typeLoop, delay);
	}

	// Start the hero typewriter slightly after the logo finishes
	setTimeout(typeLoop, 2500);
</script>
