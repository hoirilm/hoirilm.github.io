		</footer>

		<script>
			// --- Navbar Scroll Effect ---
			const navbar = document.getElementById("navbar");
			window.addEventListener("scroll", () => {
				if (window.scrollY > 20) {
					navbar.classList.add("shadow-lg");
					navbar.classList.replace("py-4", "py-2");
				} else {
					navbar.classList.remove("shadow-lg");
					navbar.classList.replace("py-2", "py-4");
				}
			});

			// --- Mobile Menu Toggle ---
			const mobileMenuBtn = document.getElementById("mobile-menu-btn");
			const mobileMenu = document.getElementById("mobile-menu");

			if (mobileMenuBtn && mobileMenu) {
				mobileMenuBtn.addEventListener("click", () => {
					mobileMenu.classList.toggle("hidden");
					const icon = mobileMenuBtn.querySelector("i");
					if (icon) {
						if (mobileMenu.classList.contains("hidden")) {
							icon.classList.remove("fa-times");
							icon.classList.add("fa-bars");
						} else {
							icon.classList.remove("fa-bars");
							icon.classList.add("fa-times");
						}
					}
				});

				// Close mobile menu on link click
				document.querySelectorAll(".mobile-link").forEach((link) => {
					link.addEventListener("click", () => {
						mobileMenu.classList.add("hidden");
						const icon = mobileMenuBtn.querySelector("i");
						if (icon) {
							icon.classList.remove("fa-times");
							icon.classList.add("fa-bars");
						}
					});
				});
			}

			// --- Scroll Reveal Animation ---
			function reveal() {
				var reveals = document.querySelectorAll(".reveal");
				for (var i = 0; i < reveals.length; i++) {
					var windowHeight = window.innerHeight;
					var elementTop = reveals[i].getBoundingClientRect().top;
					var elementVisible = 100;
					if (elementTop < windowHeight - elementVisible) {
						reveals[i].classList.add("active");
					}
				}
			}
			window.addEventListener("scroll", reveal);
			reveal(); // Trigger on load

			// --- Navbar Logo Typing Effect ---
			const logoText = "~ hoirilmochtar ";
			const logoElement = document.getElementById("nav-logo-text");
			let logoIndex = 0;

			function typeLogo() {
				if (logoElement && logoIndex < logoText.length) {
					logoElement.textContent += logoText.charAt(logoIndex);
					logoIndex++;
					// Randomize typing speed for realistic effect (50ms to 150ms)
					setTimeout(typeLogo, Math.random() * 100 + 50);
				}
			}

			// Start logo typing after a short delay
			setTimeout(typeLogo, 500);

			// --- Multi-sentence Typewriter Effect for Hero Section ---
			const phrases = [
				"I architect enterprise middleware.",
				"I integrate banking ecosystems.",
				"I explore AI-driven solutions.",
				"I build high-availability systems.",
			];

			const typeContainer = document.getElementById("typewriter-text");

			let phraseIndex = 0;
			let charIndex = 0;
			let isDeleting = false;
			let typingDelay = 100;
			let erasingDelay = 50;
			let newPhraseDelay = 2000; // Time to wait before deleting

			function typeLoop() {
				if (!typeContainer) return;

				const currentPhrase = phrases[phraseIndex];

				if (isDeleting) {
					// Erasing
					typeContainer.textContent = currentPhrase.substring(
						0,
						charIndex - 1,
					);
					charIndex--;
					setTimeout(typeLoop, erasingDelay);
				} else {
					// Typing
					typeContainer.textContent = currentPhrase.substring(
						0,
						charIndex + 1,
					);
					charIndex++;
					setTimeout(typeLoop, typingDelay);
				}

				// Logic to switch modes
				if (!isDeleting && charIndex === currentPhrase.length) {
					// End of typing, wait then start deleting
					isDeleting = true;
					setTimeout(typeLoop, newPhraseDelay);
				} else if (isDeleting && charIndex === 0) {
					// End of deleting, move to next phrase
					isDeleting = false;
					phraseIndex = (phraseIndex + 1) % phrases.length;
					setTimeout(typeLoop, typingDelay);
				}
			}

			// Start the hero typewriter slightly after the logo finishes
			setTimeout(typeLoop, 2500);

			// --- Carousel Logic (Drag & Buttons) ---
			const container = document.getElementById("projectContainer");
			const prevBtn = document.getElementById("prevBtn");
			const nextBtn = document.getElementById("nextBtn");

			if (container && prevBtn && nextBtn) {
				let isDown = false;
				let startX;
				let scrollLeft;

				// Button Scroll
				prevBtn.addEventListener("click", () => {
					container.scrollBy({ left: -400, behavior: "smooth" });
				});
				nextBtn.addEventListener("click", () => {
					container.scrollBy({ left: 400, behavior: "smooth" });
				});

				// Drag to Scroll
				container.addEventListener("mousedown", (e) => {
					isDown = true;
					container.classList.add("active:cursor-grabbing");
					container.classList.remove("snap-mandatory"); // Disable snapping while dragging
					startX = e.pageX - container.offsetLeft;
					scrollLeft = container.scrollLeft;
				});

				container.addEventListener("mouseleave", () => {
					isDown = false;
					container.classList.remove("active:cursor-grabbing");
					container.classList.add("snap-mandatory");
				});

				container.addEventListener("mouseup", () => {
					isDown = false;
					container.classList.remove("active:cursor-grabbing");
					container.classList.add("snap-mandatory");
				});

				container.addEventListener("mousemove", (e) => {
					if (!isDown) return;
					e.preventDefault();
					const x = e.pageX - container.offsetLeft;
					const walk = (x - startX) * 2; // Scroll-fast multiplier
					container.scrollLeft = scrollLeft - walk;
				});
			}
		</script>
