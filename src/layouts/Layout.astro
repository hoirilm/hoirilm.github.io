---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Hoiril Mochtar • Senior Middleware Engineer",
	description = "Hoiril Mochtar, Senior Middleware & Backend Engineer specializing in high-availability financial systems, ISO 8583, BI-FAST, QRIS, and core banking integrations based in Jakarta, Indonesia."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href="https://hoirilm.github.io" />

		<!-- OpenGraph / Twitter -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://hoirilm.github.io" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- Prevent FOUC: Inline Theme Detection -->
		<script is:inline>
			(function() {
				const storedTheme = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
	</head>
	<body class="flex min-h-dvh flex-col items-center pt-28 sm:pt-36 pb-20 px-4 sm:px-6 font-sans antialiased text-[var(--fg)] bg-[var(--bg)]">
		<!-- Top Blur Gradient Mask -->
		<div class="pointer-events-none fixed inset-0 z-40 h-28 sm:h-36">
			<div class="absolute inset-0 bg-gradient-to-b from-[var(--bg)] to-transparent"></div>
			<div class="absolute inset-0 mask-[linear-gradient(to_bottom,black_0%,black_60%,transparent_100%)] backdrop-blur-[2px]"></div>
		</div>

		<slot />
	</body>
</html>
